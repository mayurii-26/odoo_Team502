# DealFlow360 — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to git

# ── App ───────────────────────────────────────
DEBUG=true

# ── Database (PostgreSQL) ─────────────────────
DATABASE_URL=postgresql+asyncpg://dealflow:password@localhost:5432/dealflow360

# ── Auth ─────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
INVITE_TOKEN_EXPIRE_HOURS=48

# ── Email (Resend — get key at resend.com) ────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@dealflow360.com

# ── AI / LLM ─────────────────────────────────
# Use ONE of the following:
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Frontend URL (for CORS + email links) ─────
FRONTEND_URL=http://localhost:5173
